generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  createdAt DateTime   @default(now())
  decisions Decision[]
}

model Decision {
  id                String   @id @default(cuid())
  userId            String?
  decisionType      String
  website           String
  title             String?
  price             Decimal?
  category          String?
  url               String
  actionLabel       String?
  context           Json
  report            Json
  regretProbability Int
  confidenceScore   Int
  outcome           String   @default("pending")
  feedback          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([decisionType])
}

model AgentMemory {
  id           String   @id @default(cuid())
  userId       String?
  decisionId   String?
  summary      String
  embeddingRef String?
  metadata     Json
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([decisionId])
}
